rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { return request.auth != null; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function userExists() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isActive() { return isAuthenticated() && userExists() && getUserData().get('active', false) == true; }
    function isSuperAdmin() { return isActive() && getUserData().get('role', '') == 'SUPERADMIN'; }
    function isGestor() { return isActive() && getUserData().get('role', '') in ['SUPERADMIN', 'gestor', 'admin']; }
    // Curador: equipe MJ Consultoria que insere e distribui conteudo entre cartorios,
    // sem pertencer a nenhum deles e sem os demais poderes de SUPERADMIN (tenants,
    // usuarios, dados privados por cartorio). So conta para as colecoes de conteudo
    // compartilhavel (canWriteContentArray/canEditContentArray/canReadContentArray)
    // — nunca foi adicionado a isGestor() de proposito.
    function isCurador() { return isActive() && getUserData().get('role', '') == 'curador'; }
    // Equipe MJ: staff interno da MJ Consultoria que ajuda a Mirian (SUPERADMIN) a operar a
    // plataforma para todos os cartorios (colaboradores, relatorios, auditoria, conteudo,
    // dados privados de qualquer cartorio) sem pertencer a nenhum deles — mas sem os poderes
    // exclusivos de SUPERADMIN sobre a colecao tenants/cartorios (criar/excluir cartorio,
    // ativar demonstracao, habilitar/desabilitar recursos por cartorio).
    function isEquipeMJ() { return isActive() && getUserData().get('role', '') == 'equipe_mj'; }

    // Tenant isolation helpers
    function myTenant() { return getUserData().get('tenantId', ''); }
    function sameTenant() { return resource.data.get('tenantId', myTenant()) == myTenant(); }
    function newSameTenant() { return request.resource.data.get('tenantId', myTenant()) == myTenant(); }
    function tenantUnchanged() { return request.resource.data.get('tenantId', '') == resource.data.get('tenantId', ''); }
    function isSelfData() { return request.resource.data.get('userId', '') == request.auth.uid; }

    // Troca de senha no primeiro acesso: o proprio usuario grava isFirstLogin/passwordHistory
    // no seu doc. Restrito a esses campos e proibido alterar role/tenantId/active/email.
    function selfPasswordUpdate(userId) {
      return isAuthenticated() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['isFirstLogin', 'mustChangePassword', 'passwordHistory', 'passwordUpdatedAt'])
        && request.resource.data.get('role', '') == resource.data.get('role', '')
        && request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '')
        && request.resource.data.get('active', true) == resource.data.get('active', true);
    }

    // Content: SUPERADMIN vê tudo; demais usuários: mesmo tenant ou global
    function canWriteContent() { return isSuperAdmin() || isEquipeMJ() || (isGestor() && newSameTenant()); }
    function canEditContent() { return isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant() && tenantUnchanged()); }

    // Content compartilhavel entre multiplos cartorios (campo tenantIds: array, em vez de
    // tenantId escalar) — usado pelas 9 colecoes de conteudo com o seletor de visibilidade
    // "Este cartorio / Todos os cartorios / Cartorios especificos". So o SUPERADMIN pode gravar
    // um array com 'GLOBAL' ou mais de um cartorio; gestor/admin sempre grava so o proprio tenant.
    function sameTenantArray() { return myTenant() in resource.data.get('tenantIds', []); }
    function newSameTenantArray() { return request.resource.data.get('tenantIds', []) == [myTenant()]; }
    function tenantArrayUnchanged() { return request.resource.data.get('tenantIds', []) == resource.data.get('tenantIds', []); }
    function isGlobalContentArray() { return 'GLOBAL' in resource.data.get('tenantIds', []); }
    function canReadContentArray() { return isSuperAdmin() || isCurador() || isEquipeMJ() || (isActive() && (sameTenantArray() || isGlobalContentArray())); }
    function canWriteContentArray() { return isSuperAdmin() || isCurador() || isEquipeMJ() || (isGestor() && newSameTenantArray()); }
    function canEditContentArray() { return isSuperAdmin() || isCurador() || isEquipeMJ() || (isGestor() && sameTenantArray() && tenantArrayUnchanged()); }

    // Private: strictly per tenant, SUPERADMIN sees all
    function canReadPrivate() { return isSuperAdmin() || isEquipeMJ() || (isActive() && sameTenant()); }
    function canWritePrivate() { return isActive() && (isSuperAdmin() || isEquipeMJ() || newSameTenant()); }
    function canEditPrivate() { return isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant()); }
    // Private + dono do registro: usar nas coleções onde o campo userId reflete o uid autenticado
    function canWriteOwnPrivate() { return canWritePrivate() && (isSelfData() || isGestor()); }
    // Impede que o próprio usuário grave um nome/e-mail de exibição diferente do seu cadastro
    // real em registros que servem como evidência de identidade (ex.: aceite formal de
    // comunicado). Só se aplica à própria gravação (isSelfData()) — gestor gravando em nome de
    // outro colaborador não é restringido por esta checagem.
    function selfIdentityMatches() {
      return !isSelfData()
        || ((!('userNome' in request.resource.data) || request.resource.data.userNome == getUserData().get('name', ''))
            && (!('userEmail' in request.resource.data) || request.resource.data.userEmail == getUserData().get('email', '')));
    }

    match /users/{userId} {
      allow read: if isSuperAdmin()
        || isEquipeMJ()
        || request.auth.uid == userId
        || (isActive() && resource.data.get('tenantId', '') == myTenant());
      allow create: if isSuperAdmin() || isEquipeMJ() || (isGestor() && newSameTenant());
      // Equipe MJ pode editar colaboradores de qualquer cartorio, mas nao pode trocar role
      // (evita promover a si mesmo ou a terceiros a SUPERADMIN/equipe_mj).
      allow update: if isSuperAdmin()
        || ((isEquipeMJ() || (isGestor() && sameTenant())) && tenantUnchanged()
            && request.resource.data.get('role', '') == resource.data.get('role', ''))
        || selfPasswordUpdate(userId);
      allow delete: if isSuperAdmin() || isEquipeMJ();
    }

    // Fluxo de login roda sem sessao Firebase Auth ainda (nao da pra exigir isAuthenticated aqui).
    // Restringe o formato do documento para impedir bloqueio arbitrario/indefinido de contas alheias.
    match /loginAttempts/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['attempts', 'lastAttempt'])
                    && request.resource.data.attempts == 1;
      allow update: if request.resource.data.keys().hasOnly(['attempts', 'lastAttempt', 'lockedUntil'])
                    && request.resource.data.attempts is int
                    && request.resource.data.attempts >= 0
                    && request.resource.data.attempts <= resource.data.get('attempts', 0) + 1
                    && (!('lockedUntil' in request.resource.data)
                        || request.resource.data.lockedUntil == null
                        || request.resource.data.lockedUntil <= request.time + duration.value(5, 'm'));
    }

    match /auditLogs/{docId} {
      allow read: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
      // Autenticado: so pode registrar acao em nome de si mesmo (evita forjar log de outro usuario).
      // Nao autenticado: so o evento de login falho, sem severidade CRITICAL (evita poluir/forjar auditoria).
      allow create: if (isAuthenticated() && request.resource.data.get('usuarioId', '') == request.auth.uid)
                    || (!isAuthenticated()
                        && request.resource.data.get('tipo', '') == 'LOGIN_FAILED'
                        && request.resource.data.get('severity', 'INFO') != 'CRITICAL');
    }

    // ── Conteúdo compartilhável (tenantId == 'GLOBAL' = visível a todos) ──

    match /treinamentos/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }
    match /treinamentosQuizzes/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }
    match /trilhas/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }
    match /knowledgeBase/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }
    match /checklists/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }
    match /videos/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }
    match /materiaisbanner/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }
    match /comunicados/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }
    match /simulacoesPhishing/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }
    match /simulacoesPhishingCliques/{docId} {
      // Escrito somente pelas Cloud Functions (Admin SDK, ignora as regras). Clientes só leem, para evidência de auditoria.
      allow read: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
      allow write: if false;
    }
    match /campanhas/{docId} {
      allow read: if canReadPrivate();
      allow create: if canWriteOwnPrivate();
      allow update, delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /assessments/{docId} {
      allow read: if canReadPrivate();
      allow create: if canWriteContent();
      allow update: if canEditContent();
      allow delete: if isSuperAdmin();
    }
    match /dossiesConformidade/{docId} {
      allow read: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
      allow create: if isSuperAdmin() || isEquipeMJ() || (isGestor() && newSameTenant());
      allow update, delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /planosAcaoPhishing/{docId} {
      allow read: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
      allow create: if isSuperAdmin() || isEquipeMJ() || (isGestor() && newSameTenant());
      allow update, delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /repositorio/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }

    // ── Dados privados (estritamente por cartório) ──

    match /treinamentosQuizResults/{docId} {
      allow read: if canReadPrivate();
      allow create: if canWritePrivate();
      allow update: if canEditPrivate();
      allow delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /trilhasProgresso/{docId} {
      allow read: if canReadPrivate();
      allow create, update: if canWriteOwnPrivate();
      allow delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /treinamentosParticipantes/{docId} {
      allow read: if canReadPrivate();
      allow create, update: if canWritePrivate();
      allow delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /videosProgresso/{docId} {
      allow read: if canReadPrivate();
      allow create, update: if canWriteOwnPrivate();
      allow delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /comunicadosLeituras/{docId} {
      allow read: if canReadPrivate();
      allow create, update: if canWriteOwnPrivate() && selfIdentityMatches();
      allow delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /reforcosPendentes/{docId} {
      allow read: if canReadPrivate();
      allow create: if canWriteOwnPrivate();
      allow update, delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /examesResultados/{docId} {
      allow read: if canReadPrivate();
      allow create: if canWriteOwnPrivate();
      allow update, delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /metas/{docId} {
      allow read: if canReadPrivate();
      allow create: if canWriteContent();
      allow update, delete: if canEditContent();
    }
    match /metasDesempate/{docId} {
      allow read: if canReadPrivate();
      allow create: if canWriteContent();
      allow update, delete: if canEditContent();
    }
    match /repositorioProgresso/{docId} {
      allow read: if canReadPrivate();
      allow create, update: if canWriteOwnPrivate();
      allow delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /certificados/{docId} {
      allow read: if canReadPrivate();
      // Emissao de certificado exige gestor/admin — evita autoemissao de aprovacao sem concluir o treinamento
      allow create: if isSuperAdmin() || isEquipeMJ() || (isGestor() && newSameTenant());
      allow update: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant() && tenantUnchanged());
      allow delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /resumos/{docId} {
      allow read: if canReadPrivate();
      allow create: if canWritePrivate();
      allow update, delete: if canEditPrivate();
    }
    match /backup/{docId} {
      allow read, write: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /cartorios/{docId} {
      allow read: if isActive();
      allow write: if isSuperAdmin();
    }
    match /tenants/{docId} {
      // TODO(seguranca): varias telas (TenantsView, DashboardMasterView, dropdown em UsersView)
      // fazem list() sem filtro nessa colecao — confirmar que sao SUPERADMIN-only antes de
      // restringir por tenant, senao quebra essas telas para gestores comuns.
      allow read: if isActive();
      allow write: if isSuperAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
