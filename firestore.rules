rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { return request.auth != null; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function userExists() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isActive() { return isAuthenticated() && userExists() && getUserData().get('active', false) == true; }
    function isSuperAdmin() { return isActive() && getUserData().get('role', '') == 'SUPERADMIN'; }
    function isGestor() { return isActive() && getUserData().get('role', '') in ['SUPERADMIN', 'gestor', 'admin']; }
    // Curador: equipe MJ Consultoria que insere e distribui conteudo entre cartorios,
    // sem pertencer a nenhum deles e sem os demais poderes de SUPERADMIN (tenants,
    // usuarios, dados privados por cartorio). So conta para as colecoes de conteudo
    // compartilhavel (canWriteContentArray/canEditContentArray/canReadContentArray)
    // — nunca foi adicionado a isGestor() de proposito.
    function isCurador() { return isActive() && getUserData().get('role', '') == 'curador'; }
    // Equipe MJ: staff interno da MJ Consultoria que ajuda a Mirian (SUPERADMIN) a operar a
    // plataforma para todos os cartorios (colaboradores, relatorios, auditoria, conteudo,
    // dados privados de qualquer cartorio) sem pertencer a nenhum deles — mas sem os poderes
    // exclusivos de SUPERADMIN sobre a colecao tenants/cartorios (criar/excluir cartorio,
    // ativar demonstracao, habilitar/desabilitar recursos por cartorio).
    function isEquipeMJ() { return isActive() && getUserData().get('role', '') == 'equipe_mj'; }
    function limiteValido(v) { return v == null || (v is int && v >= 1 && v <= 100); }
    function limitesTreinamentoValidos(l) {
      return l is map && l.keys().hasOnly(['dia', 'semana', 'mes'])
        && limiteValido(l.get('dia', null)) && limiteValido(l.get('semana', null)) && limiteValido(l.get('mes', null));
    }

    // Tenant isolation helpers
    function myTenant() { return getUserData().get('tenantId', ''); }
    // Sem tenantId no doc NAO conta como "mesmo tenant": com o default myTenant() o Firestore
    // aceitava consulta SEM filtro de tenant e um gestor listava resultados de todos os clientes
    // (visto em 2026-10-13). Docs sem tenantId ficam so com SUPERADMIN/Equipe MJ.
    function sameTenant() { return resource.data.get('tenantId', '') == myTenant(); }
    function newSameTenant() { return request.resource.data.get('tenantId', myTenant()) == myTenant(); }
    function tenantUnchanged() { return request.resource.data.get('tenantId', '') == resource.data.get('tenantId', ''); }
    function isSelfData() { return request.resource.data.get('userId', '') == request.auth.uid; }
    // So valida o formato quando o nome de fato muda nesta escrita — evita travar updates
    // de campos nao relacionados (ativo, cargo, tenantId etc.) em cadastros antigos que ainda
    // tem nome de uma palavra so, de antes dessa regra existir.
    function nameChanged() { return request.resource.data.get('name', '') != resource.data.get('name', ''); }
    function validNameOnChange() { return !nameChanged() || request.resource.data.name.matches('^\\S{2,}(\\s+\\S{2,})+$'); }

    // Content: SUPERADMIN vê tudo; demais usuários: mesmo tenant ou global
    function canWriteContent() { return isSuperAdmin() || isEquipeMJ() || (isGestor() && newSameTenant()); }
    function canEditContent() { return isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant() && tenantUnchanged()); }

    // Content compartilhavel entre multiplos cartorios (campo tenantIds: array, em vez de
    // tenantId escalar) — usado pelas 9 colecoes de conteudo com o seletor de visibilidade
    // "Este cartorio / Todos os cartorios / Cartorios especificos". So o SUPERADMIN pode gravar
    // um array com 'GLOBAL' ou mais de um cartorio; gestor/admin sempre grava so o proprio tenant.
    function sameTenantArray() { return myTenant() in resource.data.get('tenantIds', []); }
    function newSameTenantArray() { return request.resource.data.get('tenantIds', []) == [myTenant()]; }
    function tenantArrayUnchanged() { return request.resource.data.get('tenantIds', []) == resource.data.get('tenantIds', []); }
    function isGlobalContentArray() { return 'GLOBAL' in resource.data.get('tenantIds', []); }
    function canReadContentArray() { return isSuperAdmin() || isCurador() || isEquipeMJ() || (isActive() && (sameTenantArray() || isGlobalContentArray())); }
    function canWriteContentArray() { return isSuperAdmin() || isCurador() || isEquipeMJ() || (isGestor() && newSameTenantArray()); }
    function canEditContentArray() { return isSuperAdmin() || isCurador() || isEquipeMJ() || (isGestor() && sameTenantArray() && tenantArrayUnchanged()); }

    // Private: strictly per tenant, SUPERADMIN sees all
    function canReadPrivate() { return isSuperAdmin() || isEquipeMJ() || (isActive() && sameTenant()); }
    // create: o doc novo tem que ser do proprio tenant. update: o doc EXISTENTE tambem tem que ser
    // do proprio tenant e o tenantId nao pode mudar — antes so o valor novo era conferido, e quem
    // soubesse o ID de um doc de outro cliente podia sobrescreve-lo com o proprio tenant e le-lo.
    function canWritePrivate() {
      return isActive() && (isSuperAdmin() || isEquipeMJ()
        || (newSameTenant() && (resource == null || (sameTenant() && tenantUnchanged()))));
    }
    function canEditPrivate() { return isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant() && tenantUnchanged()); }
    // Notas, progresso e resultados individuais: a gestao le o tenant todo; colaborador so os
    // proprios (userId == uid). Ranking de Metas, que precisa do agregado, vem da function rankingMetas.
    function canReadOwnOrManage() {
      return isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant())
        || (isActive() && resource.data.get('userId', '') == request.auth.uid);
    }
    // Private + dono do registro: usar nas coleções onde o campo userId reflete o uid autenticado
    // No update o registro existente tambem tem que ser do proprio usuario (ou gestao do tenant).
    function canWriteOwnPrivate() {
      return canWritePrivate() && (isGestor()
        || (isSelfData() && (resource == null || resource.data.get('userId', '') == request.auth.uid)));
    }
    // Impede que o próprio usuário grave um nome/e-mail de exibição diferente do seu cadastro
    // real em registros que servem como evidência de identidade (ex.: aceite formal de
    // comunicado). Só se aplica à própria gravação (isSelfData()) — gestor gravando em nome de
    // outro colaborador não é restringido por esta checagem.
    function selfIdentityMatches() {
      return !isSelfData()
        || ((!('userNome' in request.resource.data) || request.resource.data.userNome == getUserData().get('name', ''))
            && (!('userEmail' in request.resource.data) || request.resource.data.userEmail == getUserData().get('email', '')));
    }

    match /users/{userId} {
      // Cadastro completo (e-mail, cargo, CPF quando houver): o proprio usuario e a gestao do
      // mesmo tenant. Antes qualquer colaborador ativo lia o cadastro de todos os colegas.
      allow read: if isSuperAdmin()
        || isEquipeMJ()
        || request.auth.uid == userId
        || (isGestor() && resource.data.get('tenantId', '') == myTenant());
      // Gestor nunca cria perfil de plataforma (SUPERADMIN/equipe_mj/curador): seria acesso a
      // todos os clientes. Cadastro normal passa pela function createCollaborator.
      allow create: if request.resource.data.name.matches('^\\S{2,}(\\s+\\S{2,})+$')
        && (isSuperAdmin()
            || (isEquipeMJ() && request.resource.data.get('role', '') != 'SUPERADMIN')
            || (isGestor() && newSameTenant() && request.resource.data.get('tenantId', '') != ''
                && request.resource.data.get('role', '') in ['gestor', 'admin', 'colaborador']));
      // Equipe MJ pode editar colaboradores de qualquer cartorio, mas nao pode trocar role
      // (evita promover a si mesmo ou a terceiros a SUPERADMIN/equipe_mj).
      // A troca de senha (isFirstLogin/mustChangePassword/historico) agora e gravada pela function
      // registrarNovaSenha — o proprio usuario nao edita mais o seu doc (antes conseguia desmarcar
      // a troca obrigatoria de senha sem trocar a senha).
      allow update: if validNameOnChange()
        && (isSuperAdmin()
            || ((isEquipeMJ() || (isGestor() && sameTenant())) && tenantUnchanged()
                && request.resource.data.get('role', '') == resource.data.get('role', '')));
      allow delete: if isSuperAdmin() || isEquipeMJ();
    }

    // Controle de tentativas de login agora roda só nas cloud functions checkLoginLock/
    // reportLoginResult (Admin SDK, ignora estas regras) — antes o client lia/gravava direto
    // aqui sem autenticação, o que permitia enumerar e-mails cadastrados (lendo o doc por ID
    // reversível) e manter uma conta alheia bloqueada indefinidamente (empurrando lockedUntil
    // em loop). Bloqueado por completo pro cliente.
    match /loginAttempts/{docId} {
      allow read, write: if false;
    }

    match /auditLogs/{docId} {
      allow read: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
      // Autenticado: so pode registrar acao em nome de si mesmo (evita forjar log de outro usuario).
      // Nao autenticado: so o evento de login falho, sem severidade CRITICAL (evita poluir/forjar auditoria).
      // ...e nunca no log de OUTRO cliente (so o proprio tenant ou sem tenant; staff livre).
      allow create: if (isAuthenticated() && request.resource.data.get('usuarioId', '') == request.auth.uid
                        && (isSuperAdmin() || isEquipeMJ() || isCurador()
                            || request.resource.data.get('tenantId', '') in ['', myTenant()]))
                    || (!isAuthenticated()
                        && request.resource.data.get('tipo', '') == 'LOGIN_FAILED'
                        && request.resource.data.get('severity', 'INFO') != 'CRITICAL');
    }

    // ── Conteúdo compartilhável (tenantId == 'GLOBAL' = visível a todos) ──

    match /treinamentos/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }
    match /treinamentosQuizzes/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }
    match /trilhas/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }
    match /knowledgeBase/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }
    match /checklists/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }
    match /videos/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }
    match /materiaisbanner/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }
    match /comunicados/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }
    match /simulacoesPhishing/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }
    match /simulacoesPhishingCliques/{docId} {
      // Escrito somente pelas Cloud Functions (Admin SDK, ignora as regras). Clientes só leem, para evidência de auditoria.
      allow read: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
      allow write: if false;
    }
    match /campanhas/{docId} {
      allow read: if canReadPrivate();
      allow create: if canWriteOwnPrivate();
      allow update, delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /assessments/{docId} {
      allow read: if canReadPrivate();
      allow create: if canWriteContent();
      allow update: if canEditContent();
      allow delete: if isSuperAdmin();
    }
    match /dossiesConformidade/{docId} {
      allow read: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
      allow create: if isSuperAdmin() || isEquipeMJ() || (isGestor() && newSameTenant());
      allow update, delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /planosAcaoPhishing/{docId} {
      allow read: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
      allow create: if isSuperAdmin() || isEquipeMJ() || (isGestor() && newSameTenant());
      allow update, delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /repositorio/{docId} {
      allow read: if canReadContentArray();
      allow create: if canWriteContentArray();
      allow update, delete: if canEditContentArray();
    }
    // Link/ID do arquivo no Google Drive de cada item do Repositorio — fora do doc publico pra
    // nao ficar exposto aos colaboradores (eles recebem o player pela function abrirMidia).
    // So quem pode editar o item correspondente le/grava.
    match /repositorioPrivado/{docId} {
      allow read, write: if isSuperAdmin() || isCurador() || isEquipeMJ()
        || (isGestor() && myTenant() in get(/databases/$(database)/documents/repositorio/$(docId)).data.get('tenantIds', []));
    }

    // ── Dados privados (estritamente por cartório) ──

    match /treinamentosQuizResults/{docId} {
      allow read: if canReadOwnOrManage();
      // So as functions submeterQuizModulo / submeterQuizTreinamento gravam resultado de quiz.
      allow create: if false;
      allow update: if canEditPrivate();
      allow delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /trilhasProgresso/{docId} {
      allow read: if canReadOwnOrManage();
      // O cliente so cria o documento "zerado" ao abrir a trilha; modulo lido, nota, aprovacao,
      // percentual e conclusao sao gravados pelas functions marcarModuloAssistido/submeterQuizModulo.
      allow create: if isActive() && isSelfData() && newSameTenant()
        && request.resource.data.get('concluida', false) == false
        && request.resource.data.get('percentualObrigatorios', 0) == 0
        && request.resource.data.get('modulos', {}).size() == 0;
      allow update: if false;
      allow delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /treinamentosParticipantes/{docId} {
      allow read: if canReadPrivate();
      allow create, update: if canWritePrivate();
      allow delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /videosProgresso/{docId} {
      allow read: if canReadPrivate();
      allow create, update: if canWriteOwnPrivate();
      allow delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /comunicadosLeituras/{docId} {
      allow read: if canReadPrivate();
      allow create, update: if canWriteOwnPrivate() && selfIdentityMatches();
      allow delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /reforcosPendentes/{docId} {
      allow read: if canReadPrivate();
      // Criado pela function submeterQuizTreinamento (2 reprovacoes seguidas).
      allow create: if false;
      allow update, delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /examesResultados/{docId} {
      allow read: if canReadOwnOrManage();
      // So a Cloud Function submeterExame grava resultado (corrige contra o gabarito guardado
      // em examesSessoes) — antes o cliente gravava a propria nota/aprovacao.
      allow create: if false;
      allow update, delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /metas/{docId} {
      allow read: if canReadPrivate();
      allow create: if canWriteContent();
      allow update, delete: if canEditContent();
    }
    match /metasDesempate/{docId} {
      allow read: if canReadPrivate();
      // Criado por criarDesempate e respondido por submeterDesempate (gabarito fica em
      // metasDesempateGabarito, sem acesso). A gestao so pode mudar o status ou excluir.
      allow create: if false;
      allow update: if canEditContent() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if canEditContent();
    }
    match /repositorioProgresso/{docId} {
      allow read: if canReadOwnOrManage();
      allow create, update: if canWriteOwnPrivate();
      allow delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /leituraProgresso/{docId} {
      allow read: if canReadOwnOrManage();
      allow create, update: if canWriteOwnPrivate();
      allow delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /certificados/{docId} {
      // Gestao le todos do proprio tenant; colaborador so o PROPRIO certificado — o doc modelo 2
      // guarda CPF, entao nao pode ser legivel por colegas (antes era canReadPrivate()).
      allow read: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant())
        || (isActive() && resource.data.get('colaboradorId', '') == request.auth.uid);
      // Emissao agora e sempre via Cloud Function (emitirCertificadoExame / emitirCertificadoManual)
      // — nunca direto do cliente. Isso evita forjar nota/instrutor/hash escrevendo direto no
      // documento; as functions usam o Admin SDK, que ignora estas regras. Exclusao continua
      // permitida pra gestao (ex: certificado emitido por engano), mas nunca create/update.
      allow create, update: if false;
      allow delete: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /resumos/{docId} {
      allow read: if canReadPrivate();
      allow create: if canWritePrivate();
      allow update, delete: if canEditPrivate();
    }
    match /backup/{docId} {
      allow read, write: if isSuperAdmin() || isEquipeMJ() || (isGestor() && sameTenant());
    }
    match /tenants/{docId} {
      // get: qualquer usuario ativo pode ler o PROPRIO cartorio por ID exato (necessario para
      // os toggles de recurso do Sidebar e o contador de demonstracao). list: so quem enxerga
      // todos os cartorios de proposito (SUPERADMIN/Equipe MJ, telas TenantsView e Dashboard
      // Master) — sem isso, list() sem filtro deixava qualquer gestor/colaborador consultar a
      // colecao inteira e enumerar nome/ID de todos os clientes da MJ Consultoria.
      allow get: if isSuperAdmin() || isEquipeMJ() || isCurador() || (isActive() && docId == myTenant());
      allow list: if isSuperAdmin() || isEquipeMJ();
      allow write: if isSuperAdmin();
      // Gestão do próprio cliente (e Equipe MJ) mantém só a lista de setores do cliente e o limite
      // de treinamentos por colaborador (dia/semana/mês; ausente ou null = sem limite).
      allow update: if (isEquipeMJ() || (isGestor() && docId == myTenant()))
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['setores'])
            && request.resource.data.setores is list && request.resource.data.setores.size() <= 100)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['limitesTreinamento'])
            && limitesTreinamentoValidos(request.resource.data.limitesTreinamento)));
    }

    // Config global da plataforma (ex: assinatura/instrutor do certificado) — primeira vez que
    // existe uma config de escopo "plataforma inteira" em vez de por tenant.
    match /config/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // Gabaritos — so as functions acessam (exames, quizzes de modulo, desempate).
    match /examesSessoes/{docId} {
      allow read, write: if false;
    }
    match /quizSessoes/{docId} {
      allow read, write: if false;
    }
    // Historico de senhas (scrypt) — so as functions validarNovaSenha/registrarNovaSenha.
    match /senhasHistorico/{docId} {
      allow read, write: if false;
    }
    match /metasDesempateGabarito/{docId} {
      allow read, write: if false;
    }
    // Gabarito dos quizzes de treinamento — so criarQuizTreinamento/submeterQuizTreinamento.
    match /treinamentosQuizzesGabarito/{docId} {
      allow read, write: if false;
    }
    // Banco de questoes reutilizavel (com gabarito) — so gerarExame/gerarQuizModulo.
    match /bancoQuestoes/{docId} {
      allow read, write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
